# ─────────────────────────────────────────────────────────────
#  therushabh.in — environment configuration
#  Copy to .env.local for Next dev, or .env for scripts/Docker.
#  The app serves the root domain: therushabh.in/ is the homepage,
#  therushabh.in/<slug> redirects, /dashboard etc. is the admin UI.
# ─────────────────────────────────────────────────────────────

# Public base URL of the shortener. This is what gets prefixed to slugs.
# Local dev:
PUBLIC_BASE_URL=http://localhost:3000
# Production:
# PUBLIC_BASE_URL=https://therushabh.in

# ── Database (Postgres via Neon / Vercel Postgres) ─────────────
# From the Vercel dashboard: Storage tab -> Create Database -> Neon (Serverless
# Postgres) -> it injects DATABASE_URL into your project automatically. For
# local dev, pull the same value down with `vercel env pull .env.local`, or
# copy it from the Vercel dashboard / Neon console directly.
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Auth / sessions ───────────────────────────────────────────
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_COOKIE_NAME=gs_session
# Force the Secure flag on cookies. Auto-on in production; set to 1 if behind TLS in dev.
# SECURE_COOKIES=1

# ── Link behaviour ────────────────────────────────────────────
# Length of auto-generated slugs.
SLUG_LENGTH=6
# If true, creating a link for a URL that already exists (no custom alias) reuses the existing slug.
REUSE_EXISTING=true
# Salt used to hash visitor IPs for rough unique-visitor counts (never stores raw IPs).
IP_HASH_SALT=change-me-to-a-random-salt

# ── Bootstrap admin (used by `npm run create-admin`) ──────────
ADMIN_EMAIL=rushabh5000@gmail.com
ADMIN_PASSWORD=change-me-strong-password

# ── Telegram bot (OPTIONAL secondary quick-create channel) ────
# Create a bot with @BotFather -> get the token. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
# Random secret; Telegram echoes it back in a header so you can verify webhooks.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric chat IDs allowed to use the bot (get yours from @userinfobot).
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Public link creation (/create page, no login required) ────
# Free at dash.cloudflare.com -> Turnstile -> add a site for therushabh.in.
# The public create endpoint FAILS CLOSED (503) if TURNSTILE_SECRET_KEY is
# unset, so it never accidentally goes live unprotected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Content-aware slugs, JS-rendered fallback (OPTIONAL) ───────
# Works out of the box unauthenticated (low rate limit, fine for personal
# use). Free API key at microlink.io raises the limit if needed.
MICROLINK_API_KEY=

# ── Affiliate link conversion (EarnKaro) ────────────────────────
# Non-Amazon destination URLs are routed through EarnKaro's converter API
# to attach affiliate tracking (Flipkart, Myntra, Ajio, Nykaa, etc. all go
# through this one endpoint). Amazon uses a separate static tag param
# instead (see src/lib/affiliate.ts) and never calls this API. If unset,
# every non-Amazon URL is left completely unmodified.
EARNKARO_API_TOKEN=
